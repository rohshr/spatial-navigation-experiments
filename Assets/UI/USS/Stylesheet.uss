.instructionText {
    -unity-font-definition: resource('Inter_24pt-Medium');
    font-size: 40px;
    -unity-font-style: normal;
    text-overflow: ellipsis;
    color: rgb(255, 255, 255);
}

.instructionWindow {
    background-color: rgba(0, 0, 0, 0.71);
    border-left-color: rgba(125, 125, 125, 0);
    border-right-color: rgba(125, 125, 125, 0);
    border-top-color: rgba(125, 125, 125, 0);
    border-bottom-color: rgba(125, 125, 125, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    padding-top: 64px;
    padding-right: 64px;
    padding-bottom: 64px;
    padding-left: 64px;
    margin-top: 48px;
    margin-right: 48px;
    margin-bottom: 48px;
    margin-left: 48px;
}

.actionText {
    -unity-font-definition: resource('Inter_28pt-Bold');
    font-size: 32px;
    -unity-font-style: normal;
    text-overflow: ellipsis;
    color: rgb(255, 243, 109);
}
